      "port": 5055
    },
    {
      "name": "portal-demo-web",
      "runtimeExecutable": "env",
      "runtimeArgs": ["VITE_API_URL=http://localhost:5055/api", "npm", "run", "dev", "--prefix", "frontend", "--", "--port", "5174", "--strictPort"],
      "port": 5174
    }
  ]
}
