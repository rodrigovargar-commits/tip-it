# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/tip-it

# JWT
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=180d

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/worker/stripe/refresh
STRIPE_CONNECT_RETURN_URL=http://localhost:5173/worker/stripe/return

# Comisión de TIP-IT: porcentaje + tarifa fija por transacción (en centavos).
# La tarifa fija existe porque Stripe cobra un costo fijo por transacción
# (~$3 MXN) que un % puro no cubre en propinas chicas. Ajusta estos valores
# según tu tasa real de Stripe (Dashboard > Configuración > Precios).
PLATFORM_FEE_PERCENT=6
PLATFORM_FEE_FIXED_CENTS=400

# Aviso por correo cuando alguien deja sus datos en /unete (opcional).
# 1) Crea cuenta gratis en https://resend.com  2) Crea una API key
# 3) Pon tu correo en LEAD_NOTIFY_EMAIL (varios separados por coma).
# Con el remitente de prueba (onboarding@resend.dev) Resend solo entrega al correo
# con el que abriste tu cuenta; para otros destinatarios verifica un dominio y
# cambia LEAD_NOTIFY_FROM (ej. "TIP-IT <avisos@tipit.com.mx>").
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_NOTIFY_FROM=
